---
import type { Lang } from '../i18n/translations';
import { languages, defaultLang } from '../i18n/translations';
import { getLocalePath } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  image?: string;
}
const { title, description, lang = defaultLang, image = '/images/og-image.jpg' } = Astro.props;

const siteUrl = 'https://prestia.web.app';
const canonical = `${siteUrl}${getLocalePath(lang)}`;
const ogImage = `${siteUrl}${image}`;

const firebaseApiKey = import.meta.env.PUBLIC_FIREBASE_API_KEY;
const firebaseAuthDomain = import.meta.env.PUBLIC_FIREBASE_AUTH_DOMAIN;
const firebaseProjectId = import.meta.env.PUBLIC_FIREBASE_PROJECT_ID;
const firebaseStorageBucket = import.meta.env.PUBLIC_FIREBASE_STORAGE_BUCKET;
const firebaseMessagingSenderId = import.meta.env.PUBLIC_FIREBASE_MESSAGING_SENDER_ID;
const firebaseAppId = import.meta.env.PUBLIC_FIREBASE_APP_ID;
const firebaseMeasurementId = import.meta.env.PUBLIC_FIREBASE_MEASUREMENT_ID;

const metaDesc = description || 'Prestia - Microcredit management platform';

const alternateLocales = (Object.keys(languages) as Lang[]).filter(l => l !== lang);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDesc} />
    <meta name="theme-color" content="#1565C0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/images/logo.png" />
    <link rel="canonical" href={canonical} />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="alternate" hreflang={lang} href={`${siteUrl}${getLocalePath(lang)}`} />
    {alternateLocales.map(l => (
      <link rel="alternate" hreflang={l} href={`${siteUrl}${getLocalePath(l)}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Prestia" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1080" />
    <meta property="og:image:height" content="723" />
    <meta property="og:locale" content={lang === 'es' ? 'es_AR' : lang === 'pt' ? 'pt_BR' : 'en_US'} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'Prestia',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      description: metaDesc,
      url: siteUrl,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    })} />

    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script is:inline define:vars={{ firebaseApiKey, firebaseAuthDomain, firebaseProjectId, firebaseStorageBucket, firebaseMessagingSenderId, firebaseAppId, firebaseMeasurementId }}>
      (async () => {
        const { initializeApp } = await import("https://www.gstatic.com/firebasejs/12.10.0/firebase-app.js");
        const { getAnalytics } = await import("https://www.gstatic.com/firebasejs/12.10.0/firebase-analytics.js");
        const app = initializeApp({
          apiKey: firebaseApiKey,
          authDomain: firebaseAuthDomain,
          projectId: firebaseProjectId,
          storageBucket: firebaseStorageBucket,
          messagingSenderId: firebaseMessagingSenderId,
          appId: firebaseAppId,
          measurementId: firebaseMeasurementId,
        });
        getAnalytics(app);
      })();
    </script>
    <style is:global>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { font-family: 'Inter', sans-serif; color: #1a1a2e; background: #fff; }
      a { text-decoration: none; color: inherit; }
    </style>
  </body>
</html>
